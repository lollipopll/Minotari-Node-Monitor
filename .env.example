# ==============================================================================
# Tari Minotari Node Monitor Configuration
# ==============================================================================

# Target Minotari Node gRPC endpoint
# If running inside Docker and minotari_node is on host machine:
#   Linux: 172.17.0.1 or host.docker.internal
#   macOS/Windows: host.docker.internal
# If minotari_node runs in the same Docker network: use container name, e.g. minotari_node
TARI_NODE_GRPC_HOST=127.0.0.1

# Default Tari gRPC ports:
# 18145 = Esmeralda Testnet
# 18142 = Mainnet
# 18188 = Nextnet
TARI_NODE_GRPC_PORT=18145

# Polling frequency in seconds (recommended: 10 to 30)
POLL_INTERVAL_SECONDS=15

# Web UI Dashboard Server Bind
WEB_HOST=0.0.0.0
WEB_PORT=8000

# GitHub Repository for release checking
GITHUB_REPO=tari-project/tari
GITHUB_CHECK_INTERVAL_SECONDS=1800

# Security / TLS configuration for gRPC
# Set to 'true' if your Tari node requires TLS/mTLS credentials
TARI_NODE_TLS=false
TARI_CA_CERT_PATH=

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
